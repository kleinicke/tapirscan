+    }
+    let before = work.association_truncated;
+    let enough = budget.pixels_left >= N;
+    let result = row(im, e, budget, work);
+    if enough && work.association_truncated == before && cache.rows.len() < 256 {
+        cache.rows.insert(key, result);
+    }
+    result

+                fraction: f,
+                left: lo + (hi - lo) * (l + 0.5) / n as f64,
+                right: lo + (hi - lo) * (r + 0.5) / n as f64,
+                cost: 0.,
+                gap: 0.,
+                short_quiet: false,
+                ambiguous: true,
+            });
+        }
+    }
+    pub fn finish(&mut self, im: ImageView<'_>) -> String {

+        assert!(!spaced(&[obs(0.3), obs(0.3001), obs(0.4)]));
+        assert!(spaced(&[obs(0.3), obs(0.32), obs(0.4)]));
+        assert!(!spaced(&[obs(0.3), obs(0.3), obs(0.4)]));
+    }

+        let obs = |fraction| Observation {
+            invalid_checksum: true,
+            short_quiet: false,
+            ambiguous: true,
+            digits: [1; 13],
+            axis: 0,
+            fraction,
+            left: 0.1,
+            right: 0.9,
+            cost: 0.01,
+            gap: 0.2,
+        };
+        let spaced = |v: &[Observation]| {
+            invalid_track_spaced(
+                m,
+                &d,
+                v,
+                &mut AssociationBudget::default(),
+                &mut Work::default(),
+            )

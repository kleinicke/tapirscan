+// Column geometry is invariant across rows. The integer RGB dot product is
+// exactly the former f64 sum: bounded integer inputs and binary denominator256.
+fn secondary_gray(im: ImageView<'_>, w: usize, h: usize, gray: &mut [f32]) {
+    let columns: Vec<_> = (0..w)
+        .map(|x| {
+            let sx = ((x as f64 + 0.5) * im.width as f64 / w as f64 - 0.5)
+                .clamp(0., (im.width - 1) as f64);
+            let x0 = sx.floor() as usize;
+            (
+                x0 * im.channels,
+                (x0 + 1).min(im.width - 1) * im.channels,
+                sx - x0 as f64,
+            )
+        })
+        .collect();
+    let lum = |row: &[u8], i: usize| {
+        if im.channels == 1 {
+            f64::from(row[i])
+        } else {
+            f64::from(
+                77 * u32::from(row[i]) + 150 * u32::from(row[i + 1]) + 29 * u32::from(row[i + 2]),
+            ) / 256.
+        }
+    };
+    for y in 0..h {
+        let sy = ((y as f64 + 0.5) * im.height as f64 / h as f64 - 0.5)
+            .clamp(0., (im.height - 1) as f64);
+        let y0 = sy.floor() as usize;
+        let y1 = (y0 + 1).min(im.height - 1);
+        let fy = sy - y0 as f64;
+        let top = &im.data[y0 * im.stride..];
+        let bottom = &im.data[y1 * im.stride..];
+        for (x, &(x0, x1, fx)) in columns.iter().enumerate() {
+            let a = lum(top, x0);
+            let b = lum(top, x1);
+            let c = lum(bottom, x0);
+            let d = lum(bottom, x1);
+            let u = a + (b - a) * fx;
+            let v = c + (d - c) * fx;
+            gray[y * w + x] = (u + (v - u) * fy) as f32;
+        }
+    }

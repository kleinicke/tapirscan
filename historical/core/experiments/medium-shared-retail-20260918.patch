+pub fn expand_upce(d: &[u8; 8]) -> [u8; 12] {
+    let mut out = [0; 12];
+    out[..3].copy_from_slice(&d[..3]);
+    match d[6] {
+        0..=2 => {
+            out[3] = d[6];
+            out[8..11].copy_from_slice(&d[3..6]);
+        }
+        3 => {
+            out[3] = d[3];
+            out[9..11].copy_from_slice(&d[4..6]);
+        }
+        4 => {
+            out[3..5].copy_from_slice(&d[3..5]);
+            out[10] = d[5];
+        }
+        _ => {
+            out[3..6].copy_from_slice(&d[3..6]);
+            out[10] = d[6];
+        }
+    }
+    out[11] = d[7];

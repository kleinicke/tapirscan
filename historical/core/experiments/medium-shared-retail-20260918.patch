+                a.digits == o.digits
+                    && a.axis == axis
+                    && (a.fraction - f).abs() < 1e-9
+                    && a.right.min(o.right) - a.left.max(o.left)
+                        > 0.9 * (a.right - a.left).max(o.right - o.left)

+            self.peak_row.clear();
+            self.peak_row.extend(
+                p.iter()
+                    .map(|v| ((1. - v) * 255.).round().clamp(0., 255.) as u8),
+            );
+            &self.peak_row
+        } else {
+            row_owned = p
+                .iter()
+                .map(|v| ((1. - v) * 255.).round().clamp(0., 255.) as u8)
+                .collect::<Vec<_>>();
+            &row_owned
+        };

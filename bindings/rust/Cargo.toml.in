[package]
license = "MIT"
authors = ["Florian Nick"]
name = "tapirscan"
version = "1.2.0"
edition = "2021"
publish = false

[dependencies]
serde = { version = "=1.0.228", features = ["derive"] }
barcode-multiformat = { path = "@ROOT@/multiformat" }
serde_json = { version = "=1.0.150", features = ["float_roundtrip"] }
barcode-research-core = { path = "../native-core", default-features = false, features = @FEATURES@ }

recovery-core = { package = "tapirscan-recovery-core", path = "../recovery-core", default-features = false, features = @LOW_FEATURES@ }

[features]
default = ["@MODE@"]
low = []
medium = []
high = []
very-high = []

[package]
license = "MIT OR Apache-2.0"
authors = ["Florian Nick"]
name = "tapirscan-native"
version = "1.3.0"
edition = "2021"
publish = false
[lib]
name = "tapirscan"
crate-type = ["cdylib"]
doctest = false
[dependencies]
serde_json = "=1.0.150"
# Renamed: the C library itself is named tapirscan.
tapirscan-api = { package = "tapirscan", path = "@PUBLIC_CRATE@", default-features = false, features = ["mode-low", "mode-medium", "mode-high", "mode-very-high"] }
[profile.release]
# Unwinding is caught at the C boundary; the pinned WASM builds remain unchanged.
panic = "unwind"
# Fat LTO with one codegen unit measured 2-4% slower here than the defaults.

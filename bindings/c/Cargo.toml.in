[package]
license = "MIT OR Apache-2.0"
authors = ["Florian Nick"]
name = "tapirscan-native-@MODE@"
version = "1.2.2"
edition = "2021"
publish = false
[lib]
name = "tapirscan_@LIB_MODE@"
crate-type = ["cdylib", "rlib"]
[dependencies]
serde_json = "=1.0.150"
tapirscan = { path = "@PUBLIC_CRATE@", default-features = false, features = ["mode-@MODE@"] }
[features]
default = ["mode-@MODE@"]
mode-low = []
mode-medium = []
mode-high = []
mode-very-high = []
[profile.release]
# Unwinding is caught at the C boundary; the pinned WASM builds remain unchanged.
panic = "unwind"
# Fat LTO with one codegen unit measured 2-4% slower here than the defaults.

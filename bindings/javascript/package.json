{
  "name": "tapirscan",
  "version": "1.2.1",
  "type": "module",
  "description": "Orientation-aware barcode scanning with a Rust/WASM core and four effort modes",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "examples",
    "THIRD_PARTY_NOTICES.md",
    "wasm/low-maintained-core-20260922.wasm",
    "wasm/medium-maintained-core-20260922.wasm",
    "wasm/high-maintained-core-20260922.wasm",
    "wasm/very-high-maintained-core-20260922.wasm"
  ],
  "scripts": {
    "build": "node scripts/clean-dist.mjs && tsc -p tsconfig.json",
    "test": "node --test test/scanner.mjs test/shared-retail.mjs && tsc --noEmit --strict --skipLibCheck --target ES2022 --module NodeNext test/api-types.ts",
    "prepack": "npm run build && node scripts/verify-package.mjs"
  },
  "devDependencies": {
    "typescript": "5.8.3"
  },
  "keywords": [
    "barcode",
    "ean13",
    "scanner",
    "wasm",
    "computer-vision",
    "typescript"
  ],
  "engines": {
    "node": ">=20"
  },
  "license": "MIT",
  "author": "Florian Nick",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kleinicke/tapirscan.git",
    "directory": "bindings/javascript"
  },
  "homepage": "https://github.com/kleinicke/tapirscan#readme",
  "bugs": {
    "url": "https://github.com/kleinicke/tapirscan/issues"
  }
}

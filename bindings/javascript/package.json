{
  "name": "tapirscan",
  "version": "1.3.0",
  "type": "module",
  "description": "Orientation-aware barcode scanning with a Rust/WASM core and four effort modes",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./browser": {
      "types": "./dist/browser.d.ts",
      "import": "./dist/browser.js"
    },
    "./wasm/low.wasm": "./wasm/low.wasm",
    "./wasm/medium.wasm": "./wasm/medium.wasm",
    "./wasm/high.wasm": "./wasm/high.wasm",
    "./wasm/very-high.wasm": "./wasm/very-high.wasm",
    "./wasm/experimental-turbo2.wasm": "./wasm/experimental-turbo2.wasm",
    "./wasm/experimental-turbo4.wasm": "./wasm/experimental-turbo4.wasm",
    "./wasm/experimental-turbo8.wasm": "./wasm/experimental-turbo8.wasm",
    "./wasm/experimental-turbo16.wasm": "./wasm/experimental-turbo16.wasm"
  },
  "files": [
    "dist",
    "examples",
    "THIRD_PARTY_NOTICES.md",
    "wasm/low.wasm",
    "wasm/medium.wasm",
    "wasm/high.wasm",
    "wasm/very-high.wasm",
    "wasm/experimental-turbo2.wasm",
    "wasm/experimental-turbo4.wasm",
    "wasm/experimental-turbo8.wasm",
    "wasm/experimental-turbo16.wasm",
    "wasm/build.json"
  ],
  "scripts": {
    "build": "node scripts/clean-dist.mjs && tsc -p tsconfig.json",
    "test": "node --test test/camera-example.mjs test/scanner.mjs test/shared-retail.mjs test/loading.mjs test/turbo.mjs test/packaging.mjs && tsc --noEmit --strict --skipLibCheck --target ES2022 --module NodeNext test/api-types.ts",
    "test:browser": "node --test --test-timeout=120000 test/browser.mjs",
    "prepack": "npm run build && node scripts/verify-package.mjs"
  },
  "devDependencies": {
    "playwright-core": "1.63.0",
    "typescript": "5.8.3"
  },
  "keywords": [
    "barcode",
    "ean13",
    "scanner",
    "wasm",
    "computer-vision",
    "typescript"
  ],
  "engines": {
    "node": ">=20"
  },
  "license": "MIT OR Apache-2.0",
  "author": "Florian Nick",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kleinicke/tapirscan.git",
    "directory": "bindings/javascript"
  },
  "homepage": "https://github.com/kleinicke/tapirscan#readme",
  "bugs": {
    "url": "https://github.com/kleinicke/tapirscan/issues"
  }
}
